generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String?
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model Car {
  id           Int       @id @default(autoincrement())
  make         String
  model        String
  year         Int
  category     String
  dailyRate    Int
  weeklyRate   Int?
  currency     String
  location     String
  imageUrl     String
  transmission String
  fuel         String
  seats        Int
  engine       String?
  horsepower   Int?
  licensePlate String?
  supplier     String
  phone        String
  whatsapp     String
  email        String
  rating       Float
  reviewCount  Int
  isFeatured   Boolean   @default(false)
  isPremium    Boolean   @default(false)
  tags         String[]  @default([])
  bookings     Booking[]
}

model Booking {
  id        Int           @id @default(autoincrement())
  userId    String
  carId     Int
  startDate DateTime
  endDate   DateTime
  status    BookingStatus @default(PENDING)
  totalCost Int
  user      User          @relation(fields: [userId], references: [id])
  car       Car           @relation(fields: [carId], references: [id])
}
